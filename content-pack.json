  "cases": [
    {
      "title": "Choque séptico",
      "text": "72 kg, infeção provável, MAP 54, lactato 4,6 e pele marmoreada. Prioridade?",
      "choices": [
        "Aguardar nova gasimetria",
        "Ressuscitação/hemodinâmica imediata + acelerar antimicrobianos/source control",
        "Apenas diurético",
        "Reduzir monitorização"
      ],
      "correct": 1,
      "why": "Sépsis/choque é emergência; tratamento, hemodinâmica, antimicrobianos e source control devem ser acelerados."
    },
    {
      "title": "Ventilação protetora",
      "text": "ARDS, PBW 60 kg, Vt 540 mL, Pplat 32, PEEP 10. O que rever?",
      "choices": [
        "Vt ≈9 mL/kg + Pplat elevada",
        "PEEP 10 isolada",
        "FC desconhecida",
        "Sexo"
      ],
      "correct": 0,
      "why": "Vt/PBW elevado e Pplat >30 são sinais para rever a estratégia e a validade das medições."
    },
    {
      "title": "AVC + LVO",
      "text": "Défice incapacitante, 2 h, TC sem hemorragia e suspeita LVO. Circuito?",
      "choices": [
        "Esperar 24 h",
        "Acelerar angioimagem/reperfusão; IVT elegível não deve atrasar MT",
        "PA <120 sempre",
        "Alta"
      ],
      "correct": 1,
      "why": "A suspeita de LVO deve acelerar a via de trombectomia; elegibilidade para IVT é avaliada em paralelo."
    },
    {
      "title": "QRS largo",
      "text": "FC 175 regular, QRS 170 ms, hipotensão e alteração da consciência.",
      "choices": [
        "TSV benigna",
        "Taquicardia ventricular é diagnóstico crítico a assumir/excluir e instabilidade determina urgência",
        "FA lenta",
        "Repetir ECG amanhã"
      ],
      "correct": 1,
      "why": "Taquicardia de QRS largo associada a instabilidade exige abordagem urgente."
    },
    {
      "title": "Hipercaliemia",
      "text": "K 6,7 mmol/L em subida + QRS a alargar.",
      "choices": [
        "Sem urgência",
        "ECG/monitorização + protocolo urgente conforme contexto",
        "Água oral",
        "Suspender ECG"
      ],
      "correct": 1,
      "why": "Hipercaliemia marcada com alteração elétrica é uma emergência clínica."
    }
  ],
