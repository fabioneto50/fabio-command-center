  "drugs": [
    {
      "name": "Noradrenalina",
      "cls": "Vasopressor α predominante",
      "use": "Choque vasodilatador / suporte de MAP",
      "monitor": "PA, perfusão, FC/ritmo, extravasamento",
      "risks": "Isquemia, arritmia, extravasamento; concentração varia por serviço."
    },
    {
      "name": "Adrenalina",
      "cls": "Catecolamina α/β",
      "use": "PCR, anafilaxia e suporte vasoativo conforme indicação",
      "monitor": "Ritmo, PA, lactato, glicemia, perfusão",
      "risks": "Taquiarritmia, hiperglicemia, aumento de lactato."
    },
    {
      "name": "Dobutamina",
      "cls": "Inotrópico β",
      "use": "Baixo débito/disfunção cardíaca selecionada",
      "monitor": "PA, FC/ritmo, perfusão e resposta",
      "risks": "Taquiarritmia e hipotensão."
    },
    {
      "name": "Dopamina",
      "cls": "Catecolamina",
      "use": "Situações selecionadas conforme protocolo",
      "monitor": "Ritmo, PA, perfusão",
      "risks": "Arritmogenicidade."
    },
    {
      "name": "Propofol",
      "cls": "Sedativo-hipnótico",
      "use": "Sedação/procedimentos/anestesia",
      "monitor": "RASS, PA, ventilação, triglicéridos se prolongado",
      "risks": "Hipotensão, depressão respiratória, PRIS em contexto de risco."
    },
    {
      "name": "Dexmedetomidina",
      "cls": "Agonista α2",
      "use": "Sedação cooperativa/ligeira selecionada",
      "monitor": "RASS, FC, PA, delirium",
      "risks": "Bradicardia e hipotensão."
    },
    {
      "name": "Alfentanil",
      "cls": "Opioide",
      "use": "Analgesia/sedoanalgesia",
      "monitor": "Dor, ventilação, consciência",
      "risks": "Depressão respiratória, hipotensão, rigidez em situações específicas."
    },
    {
      "name": "Remifentanil",
      "cls": "Opioide ultracurto",
      "use": "Analgesia/sedoanalgesia titulável",
      "monitor": "Dor, ventilação, PA, sedação",
      "risks": "Depressão respiratória, rigidez, rebound/hiperalgesia."
    },
    {
      "name": "Rocurónio",
      "cls": "Bloqueador neuromuscular",
      "use": "Intubação/bloqueio conforme indicação",
      "monitor": "TOF se perfusão, sedação/analgesia, ventilação",
      "risks": "Paralisia sem sedação é evento crítico."
    },
    {
      "name": "Insulina",
      "cls": "Hipoglicemiante",
      "use": "Controlo glicémico e protocolos específicos",
      "monitor": "Glicemia seriada, K⁺",
      "risks": "Hipoglicemia e hipocaliemia."
    },
    {
      "name": "Amiodarona",
      "cls": "Antiarrítmico classe III",
      "use": "Arritmias selecionadas",
      "monitor": "Ritmo, QT, PA",
      "risks": "Hipotensão IV, bradicardia e QT prolongado."
    },
    {
      "name": "Heparina",
      "cls": "Anticoagulante",
      "use": "Anticoagulação conforme indicação",
      "monitor": "aPTT/anti-Xa conforme protocolo, plaquetas, hemorragia",
      "risks": "Hemorragia e HIT."
    }
